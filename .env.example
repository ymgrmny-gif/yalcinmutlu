# Cloudflare Pages Function /api/contact
# Configure these as runtime variables/secrets in Cloudflare, not as NEXT_PUBLIC values.
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=

# Optional email notification after the database insert succeeds.
# Keep the recipient and API key in Cloudflare; do not expose them in client-side code.
RESEND_API_KEY=
CONTACT_TO_EMAIL=
CONTACT_FROM_EMAIL=

# EmailJS remains installed only as a fallback option and is not used by the current contact form.
