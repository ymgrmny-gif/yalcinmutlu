# Cloudflare Pages Function /api/contact
# Configure these as runtime variables/secrets in Cloudflare, never as NEXT_PUBLIC values.
SUPABASE_URL=https://fxpcmlkmkwiwocvrhpvj.supabase.co
SUPABASE_SERVICE_ROLE_KEY=

# Optional email notification after the database insert succeeds.
# Keep the recipient and API key only in Cloudflare runtime secrets.
RESEND_API_KEY=
CONTACT_TO_EMAIL=
CONTACT_FROM_EMAIL=

# Contact messages are stored in:
# public.yalcinmutlu_contact_messages
#
# EmailJS remains installed only as a fallback option and is not used by the current contact form.
